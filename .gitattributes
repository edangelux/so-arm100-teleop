# Los scripts DEBEN llevar finales de línea LF.
# Si Git en Windows los convierte a CRLF, Linux falla al ejecutarlos con
# "bad interpreter: /usr/bin/env bash^M: No such file or directory".
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf

# Binarios: que Git no los toque
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
